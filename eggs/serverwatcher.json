    "name": "ServerWatcher",
    "author": "me@ifamished.com",
    "description": "Automatically runs and installs ServerWatcher.",
    "features": [],
    "docker_images": {
        "Python 3.14": "ghcr.io/red-shadows-rs/pterodactyl-containers/python:v3.14"
    },
    "file_denylist": [],
    "startup": "pip install --upgrade pip && ( [[ \"{{SERVERWATCHER_DEV}}\" == \"1\" ]] && pip install -U --pre serverwatcher || pip install -U serverwatcher ) && ( [[ \"{{HUNGERLIB_DEV}}\" == \"1\" ]] && pip install -U --pre hungerlib || pip install -U hungerlib ) && ( [[ \"{{MAPRES_DEV}}\" == \"1\" ]] && pip install -U --pre mapres || pip install -U mapres ) && ( [[ \"{{C2E_DEV}}\" == \"1\" ]] && pip install -U --pre c2e || pip install -U c2e ) && python3 -m serverwatcher",
    "config": {
        "files": "{}",
        "startup": "{\r\n    \"done\": \"ServerWatcher is running!\"\r\n}",
        "logs": "{}",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# Unified ServerWatcher Installer\n# Server Files: /mnt/server\n\napt update\napt install -y python3 python3-pip\n\nmkdir -p /mnt/server\ncd /mnt/server\n\npip install -U pip\npip install serverwatcher\n\necho \"install complete\"\nexit 0",
            "container": "python:3.8-slim-bookworm",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "ServerWatcher dev",
            "description": "Install ServerWatcher prerelease versions",
            "env_variable": "SERVERWATCHER_DEV",
            "default_value": "0",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|boolean",
            "field_type": "text"
        },
        {
